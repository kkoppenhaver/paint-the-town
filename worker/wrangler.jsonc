{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paint-the-town",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // One Durable Object per game room holds canonical state, the WebSockets, and the clock.
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "GameRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],

  // The built SPA + the full board.json (with map geojson) are served as static assets.
  // /ws and /rooms/* hit the Worker first; everything else serves an asset, falling back
  // to index.html so the client-side app handles its own routes.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/ws", "/rooms/*"]
  }
}
